# Public (browser-safe) — Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — service role for trusted writes (NEVER expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# Tenant routing
NEXT_PUBLIC_ROOT_DOMAIN=earnedhome.com

# Pricing engine adapter: "stub" (default) | "graph" (Phase 1A.2)
PRICING_ADAPTER=stub

# --- Phase 1A.2: Microsoft Graph (Entra app) — not used while PRICING_ADAPTER=stub ---
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_WORKBOOK_DRIVE_ID=
GRAPH_WORKBOOK_ITEM_ID=

# Output read mode: "cells" (default — one read per output name) | "grid"
# ("grid" reads the EH_Out!eh_out_grid block in one call — needs the EH_Out tab +
#  eh_out_grid named range in the workbook first).
GRAPH_OUTPUT_MODE=cells

# --- Buyer estimate email (Resend) — optional; the send no-ops if unset ---
# RESEND_API_KEY = your Resend API key; RESEND_FROM = a verified from-address
# (e.g. "EarnedHome <estimates@yourdomain.com>"). Requires a verified domain.
RESEND_API_KEY=
RESEND_FROM=

# --- Daily Broadcast (bulk email) — DORMANT until BROADCAST_FROM is set ---
# Broadcasts send from a DEDICATED sending subdomain, kept separate from RESEND_FROM
# so a marketing complaint never hurts transactional deliverability. Set BROADCAST_FROM
# to a verified news. sender (e.g. "R Parry Financial <news@news.rparryfinancial.com>").
# While this is blank, the Broadcasts Send buttons are disabled and nothing is emailed.
# The email footer mirrors the Word mail-merge: a footer logo, Privacy Notice link,
# and an address · website · phone · NMLS line. All default to R Parry's values;
# override any per environment. BROADCAST_FOOTER_LOGO is a path under /public
# (default "/brand/rparry-logo.png") or a full https URL.
BROADCAST_FROM=
BROADCAST_ADDRESS=
BROADCAST_WEBSITE=
BROADCAST_PHONE=
BROADCAST_PRIVACY_URL=
BROADCAST_FOOTER_LOGO=
